# Konfigurácia sa validuje pri štarte (zod). Chýbajúca hodnota = pád, nie default.
NODE_ENV=development
PORT=3000

COUCH_URL=http://127.0.0.1:5984
COUCH_USER=
COUCH_PASSWORD=
COUCH_DB=dosledujto_register

LOG_LEVEL=info

# Session cookie: TTL a rolling refresh (najviac raz za SESSION_REFRESH_MIN minút)
SESSION_TTL_DAYS=30
SESSION_REFRESH_MIN=60
# Prázdne = podľa NODE_ENV (v produkcii true)
COOKIE_SECURE=

# Cloudflare Turnstile. Bez neho sa API v produkcii nespustí.
TURNSTILE_SECRET=
# Verejný kľúč toho istého Turnstile widgetu — ide do formulára podnetu na webe.
TURNSTILE_SITE_KEY=

# Verejná adresa webu (og:image a iné absolútne odkazy). Prázdne = og:image sa nevypíše.
PUBLIC_URL=

# API za reverse proxy
TRUST_PROXY=false
# IP adresy sa logujú len hashované — v produkcii povinné
IP_HASH_SALT=

# „Zabudnuté, ale nevyriešené" na titulke: otvorená kauza s aspoň N článkami,
# o ktorej X dní nič nevyšlo.
FORGOTTEN_MIN_ARTICLES=20
FORGOTTEN_SILENCE_DAYS=365
