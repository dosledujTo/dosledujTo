# Skopíruj na docker/.env a uprav. Compose ho číta cez `env_file`.
#
# Konfigurácia sa pri štarte validuje cez zod — chýbajúca alebo neplatná hodnota
# znamená pád, nie tichý default. Prázdna hodnota sa berie ako nenastavená.

# ── Ktoré kontajnery štartovať ───────────────────────────────────────────────
# Bez profilu sa nespustí nič. Dá sa to aj z príkazového riadka
# (`docker compose --profile app up -d`), toto je pohodlnejšie.
COMPOSE_PROFILES=app,workers

# ── CouchDB ──────────────────────────────────────────────────────────────────
# CouchDB zatiaľ nie je súčasťou tejto compose — beží mimo nej. Meno kontajnera
# Docker rozlíši len v spoločnej sieti (viď sieť `couch` v docker-compose.yml).
#
#   CouchDB z docker/couchdb-3-with-cluseau   http://cdb_couchdb:5984
#   tá istá cez jej nginx z hosta             http://host.docker.internal:5985
#   CouchDB priamo na hoste                   http://host.docker.internal:5984
#
# Meno služby (`cdb_couchdb`) je stabilnejšie než meno kontajnera
# (`couchdb-clouseau-cdb_couchdb-1`) — to sa mení s menom projektu.
COUCH_URL=http://cdb_couchdb:5984
# Externá sieť, v ktorej CouchDB beží — naše kontajnery sa do nej pripoja.
COUCH_NETWORK=docker-networks_network_couch
COUCH_USER=admin
COUCH_PASSWORD=
COUCH_DB=dosledujto_register

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=true
# Verejná adresa webu, z nej sa skladá og:image. Prázdne = og:image sa nevypíše.
PUBLIC_URL=https://dosleduj.example

SESSION_TTL_DAYS=30
SESSION_REFRESH_MIN=60
# Prázdne = podľa NODE_ENV (v produkcii true)
COOKIE_SECURE=

# ── Crawler ──────────────────────────────────────────────────────────────────
CRAWL_CRON=*/30 * * * *
CRAWLER_USER_AGENT=dosledujto-bot/0.1 (+https://dosleduj.to; kontakt@dosleduj.to)
CRAWL_MIN_INTERVAL_MS=1000
CRAWL_MAX_ITEMS=50

# ── Povinné pri NODE_ENV=production ──────────────────────────────────────────
# Bez nich API v produkcii **nenaštartuje** — je to zámer, nie prekážka.
# TURNSTILE_SECRET=
# Verejný kľúč toho istého Turnstile widgetu — ide do formulára podnetu na webe.
# TURNSTILE_SITE_KEY=
# IP_HASH_SALT=

# „Zabudnuté, ale nevyriešené" na titulke: otvorená kauza s aspoň N článkami,
# o ktorej X dní nič nevyšlo.
FORGOTTEN_MIN_ARTICLES=20
FORGOTTEN_SILENCE_DAYS=365
