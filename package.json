{
  "type": "module",
  "scripts": {
    "couch:validate": "couchman validate",
    "couch:plan": "couchman plan --env=local",
    "couch:push": "couchman push --env=local",
    "couch:fixtures": "couchman fixtures push --env=local",
    "couch:generate": "node couch/fixtures/generate.js",
    "couch:warm": "couchman warm --env=local",
    "couch:info": "couchman info --env=local",
    "api": "node --env-file-if-exists=.env packages/api/src/server.js",
    "test": "vitest run",
    "worker:crawl": "node --env-file-if-exists=.env packages/worker/src/bin/crawl.js",
    "worker:datasets": "node --env-file-if-exists=.env packages/worker/src/bin/datasets.js",
    "admin:dev": "vite --config packages/admin/vite.config.js packages/admin",
    "admin:build": "vite build --config packages/admin/vite.config.js packages/admin",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml --profile app --profile workers up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --profile app --profile workers down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f docker/docker-compose.yml ps",
    "docker:up:app": "docker compose -f docker/docker-compose.yml --profile app up -d",
    "docker:up:workers": "docker compose -f docker/docker-compose.yml --profile workers up -d",
    "docker:deps": "docker compose -f docker/docker-compose.yml run --rm --no-deps pm2-api-admin npm ci",
    "docker:reload": "docker compose -f docker/docker-compose.yml exec pm2-api-admin pm2 reload all",
    "admin:create": "node --env-file-if-exists=.env packages/shared/src/bin/create-admin.js",
    "codelists:seed": "node --env-file-if-exists=.env packages/shared/src/bin/seed-codelists.js",
    "web:build": "vite build --config packages/web/vite.config.js && vite build --config packages/web/vite.config.js --ssr src/entry-server.jsx"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "couchman": "^1.0.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "admin-lte": "^4.2.0",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "d3-force": "3.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "nano": "^11.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  }
}
